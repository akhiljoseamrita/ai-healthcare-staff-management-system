# Django core settings
SECRET_KEY=replace-me-with-a-secure-key
DEBUG=True
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Supabase Auth admin credentials for staff/hospital registration APIs
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-your-service-role-key
SUPABASE_ANON_KEY=replace-me-with-your-anon-key

# Optional AI recommendation layer (Firebase/Gemini).
AI_RECOMMENDATIONS_ENABLED=false
AI_PROVIDER=firebase_gemini
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
